# Docker images
NESSIE_VERSION=0.105.6

NESSIE_DB_IMAGE=bitnami/postgresql
NESSIE_DB_VERSION=latest

TRINO_VERSION=478

# Start date for Postgresql source data for chargy
# Loading everything since 2024-04-01 until 2025-11-10 takes 35GB in volume size
# To cut in half, use approximately 2025-01-01T00:00:00.000Z
CHARGY_START_DATE=2024-04-01T00:00:00.000Z



# Minio settings
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# PostgreSQL for Nessie metadata persistence.
NESSIE_DB_HOST=nessie-db
NESSIE_DB_PORT=5432
NESSIE_DB_DBNAME=nessie_metastore
NESSIE_DB_USERNAME=nessie_metastore_usr
NESSIE_DB_PASSWORD=nessie_metastore_pwd
NESSIE_DB_CERTPASSWORD=password
NESSIE_DB_CONTAINERUSER=1001:1001

# Shared object storage settings
STORAGE_ENDPOINT=http://minio:9000/

# Object storage settings for Nessie.
S3_NESSIE_BUCKET_NAME=nessie-metastore
S3_NESSIE_ACCESS_KEY_ID=DOENCSMFDPCQJZEOSDCK
S3_NESSIE_SECRET_ACCESS_KEY=XBE1L6FB4LD384G4NL5Z9KPW7JGH6TEWL7BKG2YV9TO9HW9PF

# Object storage settings for Dagster.
S3_DAGSTER_BUCKET_NAME=dagster
S3_DAGSTER_ACCESS_KEY_ID=KJCGDKUYSEGKJHGF
S3_DAGSTER_SECRET_ACCESS_KEY=CDJSKHGKJFGKZJEHVC872354KGJCGEZ76BCJDG63

# Object storage settings for trino
# Trino should have access to nessie bucket
S3_TRINO_ACCESS_KEY_ID=LJHDFGFSSD
S3_TRINO_SECRET_ACCESS_KEY=LSHDLFCIUEZDKJHDGSDFCJSJDHYFG



