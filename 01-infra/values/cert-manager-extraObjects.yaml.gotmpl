deploymentMode: None
serviceAccount:
  create: false
service:
  enabled: false


extraObjects:
  - apiVersion: v1
    data:
      ca.crt: 
      tls.crt: 
      tls.key: 
    kind: Secret
    metadata:
      name: data-platform-root-ca-secret
      namespace: cert-manager
    type: kubernetes.io/tls
  - apiVersion: cert-manager.io/v1
    kind: ClusterIssuer
    metadata:
      name: data-platform-root-ca-issuer
    spec:
      ca:
        secretName: data-platform-root-ca-secret
  - apiVersion: cert-manager.io/v1
    kind: Certificate
    metadata:
      name: data-platform-ca-certificate
      namespace: {{ .Release.Namespace }}
    spec:
      secretName: data-platform-ca-secret
      issuerRef:
        name: data-platform-root-ca-issuer
        kind: ClusterIssuer
      isCA: true
      commonName: CA for the data platform
      duration: "87660h" # 10 years
      subject:
        countries: [ "LU" ]
        organizations: [ "Data-Platform" ]
  - apiVersion: cert-manager.io/v1
    kind: ClusterIssuer
    metadata:
      name: data-platform-ca-issuer
    spec:
      ca:
        secretName: data-platform-ca-secret
