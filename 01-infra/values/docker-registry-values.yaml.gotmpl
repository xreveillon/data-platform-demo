ingress:
  enabled: true
  className: traefik
  path: /
  hosts:
    - registry.{{ env "GLOBAL_DOMAIN" | default "data-platform.xreveillon.eu" }}
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure

persistence:
  enabled: false
  
# set the type of filesystem to use: filesystem, s3
storage: s3
s3:
  bucket: registry
  secure: true
  regionEndpoint: minio.minio.svc.cluster.local
  forcepathstyle: true
  skipVerify: true
  region: us-east-1

{{ $user := env "REGISTRY_USER" | default "registry" }}
{{ $password := env "REGISTRY_PASSWORD" | default "registrypassword" }}
secrets:
  htpasswd: {{ exec "docker" (list "run" "--entrypoint" "htpasswd" "httpd:2" "-Bbn" $user $password )  | quote }}
  s3:
    accessKey: {{ env "REGISTRY_S3_ACCESS_KEY" | default "registry" | quote }}
    secretKey: {{ env "REGISTRY_S3_SECRET_KEY" | default "registrypassword" | quote }}
